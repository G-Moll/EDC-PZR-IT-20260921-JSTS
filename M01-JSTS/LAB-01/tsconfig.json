{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",

        "strict": true,

        "outDir": "./dist",
        "rootDir": "./src",

        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": false,
        "sourceMap": true,
    },
    "include": [ "src/**/*" ],
    "exclude": [ "node_modules", "dist" ]
}
